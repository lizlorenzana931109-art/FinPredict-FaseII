
# FinPredict - Fase II
# Imagen Docker para FastAPI y el modelo predictivo

FROM python:3.13-slim

# Directorio de trabajo dentro del contenedor
WORKDIR /app

# Evita archivos temporales y mejora los registros
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Instala las dependencias del proyecto
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia solo los componentes requeridos por la API
COPY api/ ./api/
COPY model/ ./model/
COPY scripts/validar_entradas.py ./scripts/validar_entradas.py

# Puerto del servicio FastAPI
EXPOSE 8000

# Inicia el servicio y permite conexiones
# desde fuera del contenedor
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
